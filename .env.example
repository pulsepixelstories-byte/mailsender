# ============================================================
# Business Mail Sender - example settings. Copy to ".env" and fill in.
# You NEVER edit code files, only this ".env" copy.
# ============================================================

# From Google Cloud Console > APIs & Services > Credentials > OAuth client.
GOOGLE_CLIENT_ID=

# Same page as above.
GOOGLE_CLIENT_SECRET=

# Must match EXACTLY what you register in Google Console.
# Business Mail Sender runs on 3001 (3000 is used by another app on this Mac).
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Any long random text. Keeps you logged in.
SESSION_SECRET=change-me-to-something-long-and-random-12345

# EXACTLY 32 characters. Locks your Google tokens in the database.
# Make one with: openssl rand -hex 16
ENCRYPTION_KEY=change-me-to-exactly-32-characters!!
